# TiDB Cloud: cluster page → Connect
TIDB_HOST=your-cluster-host.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your-prefix.root
TIDB_PASSWORD=your-password
TIDB_DB_NAME=aidatlas

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key

# NASA FIRMS: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your-firms-key

# Websites allowed to call this API from a browser (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Any long random string, used to sign login cookies so they can't be faked
SESSION_SECRET=change-me
